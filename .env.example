# Copy to server/.env for local development. Never commit the real file.
# In production these are set as environment variables in the host's
# dashboard, not from a file.

# MongoDB Atlas connection string (TD-07). The app refuses to start a
# request without this -- there is no default connection string in the code.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name inside the cluster. Defaults to HaaSResourceManager.
MONGODB_DB=HaaSResourceManager

# Signs the login session cookie (TD-02). Any long random string; make one
# with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Without it, sign-ins don't survive a server restart. On Render it is
# generated automatically (render.yaml).
SECRET_KEY=<long random string>
